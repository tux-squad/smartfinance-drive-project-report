Subscriptions & Billing


@startuml
!theme plain
skinparam classAttributeIconSize 0

class Plan {
    - id: Long
    - name: String
    - description: String
    - price: BigDecimal
    - currency: String
    - billingCycle: String
    - maxSimulationsPerMonth: Integer
    - maxVehicleListings: Integer
    - active: boolean
    + displayPlanDetails(): void
}

class Subscription {
    - id: Long
    - userId: Long
    - planId: Long
    - startDate: Date
    - endDate: Date
    - status: String
    - autoRenew: boolean
    - stripeSubscriptionId: String
    + activate(): void
    + cancel(): void
    + renewSubscription(): void
}

class Invoice {
    - id: Long
    - subscriptionId: Long
    - userId: Long
    - amount: BigDecimal
    - currency: String
    - issuedAt: Date
    - dueDate: Date
    - paidAt: Date
    - status: String
    + markAsPaid(): void
    + generatePdf(): void
}

Plan "1" o-- "0..*" Subscription : defines
Subscription "1" *-- "0..*" Invoice : generates
@enduml

